# ==============================================================================
# LLM Agent Relays - Конфигурация окружения
# ==============================================================================

# Хост, на котором слушают релеи
# 127.0.0.1 - только локально (рекомендуется для Windows)
# 0.0.0.0 - доступ со всей сети / Docker
RELAY_LISTEN_HOST=127.0.0.1

# Адрес локального прокси-клиента (Hiddify / xray / v2rayN)
# На локальной машине: 127.0.0.1
# Внутри Docker: host.docker.internal
RELAY_PROXY_HOST=127.0.0.1

# Порты локальных прокси через запятую в порядке приоритета:
#   12334 - Hiddify (mixed port)
#   10808 - xray / v2rayN
RELAY_PROXY_PORTS=12334,10808

# Разрешать ли прямое подключение при сбое всех прокси (0 - выкл, 1 - вкл)
# Рекомендуется 0 в заблокированных регионах, чтобы видеть понятную 502 ошибку
RELAY_ALLOW_DIRECT=0

# Порты локальных релеев:
OPENROUTER_PORT=8818
GROQ_PORT=8819
GEMINI_PORT=8820

# Резервные API ключи (опционально, если клиент не передает Authorization header):
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIza...

# Таймауты (миллисекунды)
RELAY_CONNECT_TIMEOUT_MS=8000
RELAY_HEADER_TIMEOUT_MS=90000
RELAY_COOLDOWN_MS=60000
